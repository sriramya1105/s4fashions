# ThreadCraft Apparel - Secure REST API Configuration
APP_NAME=ThreadCraft Apparel API
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Secret keys (Loaded from env, never hardcoded per CWE-798)
SECRET_KEY=threadcraft-super-secure-production-secret-key-32bytes-min!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./threadcraft.db

# Rate Limits (SlowAPI)
DEFAULT_RATE_LIMIT=60/minute
AUTH_RATE_LIMIT=5/minute
CHECKOUT_RATE_LIMIT=10/minute
