{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/docs",
      "destination": "/api"
    },
    {
      "source": "/openapi.json",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin_portal/login.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin_portal/login.html"
    }
  ]
}
