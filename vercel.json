{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin",
      "dest": "/admin_portal/login.html"
    },
    {
      "src": "/admin/",
      "dest": "/admin_portal/login.html"
    }
  ]
}
